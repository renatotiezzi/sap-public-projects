  "padroes": [
    {
      "nome": "caminho de perfil do Windows",
      "regex": "[A-Za-z]:[\\\\/]+Users[\\\\/]+[^\\\\/\\s\"'`<>]+",
      "flags": "i"
    },
    {
      "nome": "pasta de OneDrive de empresa",
      "regex": "OneDrive - [A-Za-z]",
      "flags": ""
    },
    {
      "nome": "e-mail",
      "regex": "[A-Za-z0-9._%+-]+@(?:[A-Za-z0-9-]+\\.)+[A-Za-z]{2,}",
      "flags": ""
    }
  ],
  "permitidos": ["renatotiezzi/sap-public-projects"],
  "emailsLivres": [
    "@example.com",
    "@example.org",
    "@example.net",
    "git@github.com",
    "noreply.github.com",
    "@UI."
  ],
  "segredos": [
    {
      "nome": "chave privada",
      "regex": "-----BEGIN [A-Z ]*PRIVATE KEY-----",
      "flags": ""
    },
    {
      "nome": "token do GitHub",
      "regex": "\\b(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{30,}\\b|\\bgithub_pat_[A-Za-z0-9_]{40,}\\b",
      "flags": ""
    },
    {
      "nome": "chave de acesso da AWS",
      "regex": "\\bAKIA[0-9A-Z]{16}\\b",
      "flags": ""
    },
    {
      "nome": "client secret preenchido",
      "regex": "[\"']?client_?secret[\"']?\\s*[:=]\\s*[\"'][^\"'<>{}\\s$]{12,}[\"']",
      "flags": "i"
    },
    {
      "nome": "token do Slack",
      "regex": "\\bxox[abposr]-[A-Za-z0-9-]{10,}",
      "flags": ""
    }
  ]
}
